{
  "description": "Chronicle local workspace checkpoints for Codex CLI.",
  "hooks": {
    "SessionStart": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/hook.js\" codex", "timeout": 30 }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/hook.js\" codex", "timeout": 3 }]
    }],
    "Interrupt": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/hook.js\" codex", "timeout": 3 }]
    }],
    "PreToolUse": [{
      "matcher": "Bash|apply_patch|Edit|Write",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/hook.js\" codex", "timeout": 30 }]
    }],
    "PostToolUse": [{
      "matcher": "Bash|apply_patch|Edit|Write",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/hook.js\" codex", "timeout": 30 }]
    }]
  }
}
